# Environment variables for the portfolio site.

# --- Contact form (optional) ---
# Create a key at https://resend.com and set these to enable the contact form.
RESEND_API_KEY=
CONTACT_TO_EMAIL=pro.engrraheem@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Daily blog automation (used by scripts/generate-post.mjs) ---
# OpenAI-compatible API used to generate one unique post per day.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# Duplicate-prevention lookback window in days
DUPLICATE_LOOKBACK_DAYS=60
